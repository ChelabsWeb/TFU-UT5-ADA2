# External Configuration Store de svc-despacho
DATABASE_URL=postgresql://despacho_user:despacho_pw@postgres:5432/ambulancias
AMQP_URL=amqp://guest:guest@rabbitmq:5672/%2F?heartbeat=0&socket_timeout=2&connection_attempts=1&blocked_connection_timeout=5
FLOTA_URL=http://svc-flota:8000
RUTEO_URL=http://svc-ruteo:8000/soap
RUTEO_WSDL=/app/contracts/ruteo.wsdl
# Timeouts con presupuesto total
PRESUPUESTO_MS=2000
FLOTA_TIMEOUT_MS=500
RUTEO_TIMEOUT_MS=800
# Retry (solo operaciones idempotentes)
REINTENTOS=2
BACKOFF_BASE_MS=100
# Circuit Breaker hacia svc-ruteo
CB_VENTANA=10
CB_UMBRAL_FALLAS=0.5
CB_MINIMO_LLAMADAS=5
CB_ABIERTO_SEG=30
# Bulkhead
RUTEO_MAX_CONCURRENTES=10
FLOTA_POOL=20
MAX_CANDIDATAS=5
